# Axiome per-worktree local-dev environment — TEMPLATE / REFERENCE.
#
# You normally do NOT copy this by hand. `scripts/wt-up.sh` GENERATES the real,
# gitignored `.env` for this worktree (deriving WT_SLUG, allocating a
# collision-free PORT_OFFSET and Redis DB index, and computing every value
# below). This file documents every variable the app stack reads and how each
# per-worktree value is derived, so the mechanism is legible and reviewable.
#
# Two projects run side by side:
#   axiome-shared     the stateful commodity services (docker-compose.shared.yml)
#   axiome-<slug>     THIS worktree's app services      (docker-compose.yml)
#
# ============================================================================
# Worktree identity  (wt-up.sh derives these; override WT_SLUG to force a name)
# ============================================================================
WT_SLUG=example                 # slug = sanitized worktree dir name; namespaces
                                # the compose project (axiome-<slug>), containers,
                                # volumes, network aliases, DBs, vhost, buckets.

# Port offset, in steps of 100, allocated collision-free in the registry
# (~/.axiome/worktree-registry.json). First worktree = 0, next = 100, ...
PORT_OFFSET=0

# Derived host ports  =  base + PORT_OFFSET   (wt-up.sh computes and writes these)
BACKEND_PORT=3000               # = 3000 + PORT_OFFSET
FRONTEND_PORT=5173              # = 5173 + PORT_OFFSET
BIOCOMPUTE_PORT=8000            # = 8000 + PORT_OFFSET

# ============================================================================
# Logical isolation on the SHARED services  (all derived from WT_SLUG)
# ============================================================================
# Postgres — one database per worktree on the shared instance (never a 2nd
# container). Schemas user_svc / organization_svc live inside it.
POSTGRES_DB=example             # = WT_SLUG (created by wt-up.sh: CREATE DATABASE)

# Mongo — one event-store database per worktree on the shared instance.
MONGODB_DB=example              # = WT_SLUG

# RabbitMQ — one vhost per worktree on the shared instance.
RABBITMQ_VHOST=example          # = WT_SLUG (created + permissioned by wt-up.sh)

# Redis — one logical DB index per worktree (0..15), allocated in the registry,
# plus a reserved key prefix. NOTE: the DB index gives full keyspace isolation
# for the query cache; REDIS_PREFIX is reserved for a future adapter/key-prefix
# change (Socket.IO pub/sub is NOT DB-scoped — see docs/known follow-ups).
REDIS_DB_INDEX=0
REDIS_PREFIX=axiome:example:    # = axiome:<slug>:

# Object store — shared MinIO endpoint + credentials, disjoint bucket namespace.
# Buckets are created by wt-up.sh and named <slug>-<purpose>. Application code
# reads these from env — it never builds a bucket name from a literal.
S3_ENDPOINT=http://minio:9000           # in-network endpoint (services)
S3_PUBLIC_ENDPOINT=http://localhost:9000 # browser-facing endpoint (presigned URLs)
S3_BUCKET=example-uploads               # backend's single bucket (= S3_BUCKET_UPLOADS)
S3_BUCKET_UPLOADS=example-uploads
S3_BUCKET_ARTIFACTS=example-artifacts
S3_BUCKET_SYSTEM=example-system
BIO_COMPUTE_S3_BUCKET=example-artifacts

# ============================================================================
# Shared-service credentials  (same for every worktree — shared instances)
# These must match docker-compose.shared.yml's SHARED_* defaults.
# ============================================================================
POSTGRES_USER=axiome
POSTGRES_PASSWORD=axiome_local_dev
MONGODB_USER=axiome
MONGODB_PASSWORD=axiome_local_dev
RABBITMQ_USER=axiome
RABBITMQ_PASSWORD=axiome_local_dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=eu-west-3

# ============================================================================
# App config  (not worktree-specific)
# ============================================================================
NODE_ENV=development
JWT_SECRET=local-dev-jwt-secret-change-in-production
SESSION_SECRET=local-dev-session-secret-change-in-production
BOOTSTRAP_ADMIN_EMAIL=admin@axiome.local
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_FIRST_NAME=Local
BOOTSTRAP_ADMIN_LAST_NAME=Admin

# ============================================================================
# Source mounts  (optional overrides; default to the sibling primary checkouts)
# wt-up.sh sets these to this worktree's own submodule checkouts.
# ============================================================================
# BACKEND_SRC=../axiome-back
# FRONTEND_SRC=../axiome-front
# BIOCOMPUTE_SRC=../axiome-bio-compute

# ============================================================================
# Derived connection URLs  (composed inside docker-compose.yml from the parts
# above — shown here as formulas so the wiring is explicit; do not need setting)
# ============================================================================
#   DATABASE_URL              = postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB
#   USER_DATABASE_URL         = $DATABASE_URL?schema=user_svc
#   ORGANIZATION_DATABASE_URL = $DATABASE_URL?schema=organization_svc
#   MONGODB_URL               = mongodb://$MONGODB_USER:$MONGODB_PASSWORD@mongodb:27017/$MONGODB_DB?authSource=admin&directConnection=true
#   RABBITMQ_URL              = amqp://$RABBITMQ_USER:$RABBITMQ_PASSWORD@rabbitmq:5672/$RABBITMQ_VHOST
#   REDIS_URL                 = redis://redis:6379/$REDIS_DB_INDEX
#   BIO_COMPUTE_URL           = http://biocompute-$WT_SLUG:8000
#   CALLBACK_BASE_URL         = http://backend-$WT_SLUG:3004
#   VITE_API_URL              = http://localhost:$BACKEND_PORT/api/v1
#   VITE_GATEWAY_WS_URL       = http://localhost:$BACKEND_PORT
#   VITE_BIOCOMPUTE_URL       = http://localhost:$BIOCOMPUTE_PORT

# ============================================================================
# Analytics / Metabase read layer (optional — see analytics/README.md)
# ============================================================================
METABASE_RO_USER=felipe.guimaraes@axiomebio.com
METABASE_RO_PASSWORD=xxxx
